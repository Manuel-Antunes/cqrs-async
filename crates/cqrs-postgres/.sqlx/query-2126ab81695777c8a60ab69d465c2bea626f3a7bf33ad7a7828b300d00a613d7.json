  "query": "SELECT position, stream_type, stream_id, sequence, event_type, event_version, payload::text AS \"payload!\", metadata::text AS \"metadata!\", (extract(epoch FROM recorded_at) * 1000000)::bigint AS \"recorded_us!\" FROM cqrs_events WHERE log = $1 AND position IN (SELECT t.position FROM cqrs_event_tags t WHERE t.log = $1 AND t.tag = ($2::text[])[1] AND (SELECT count(*) FROM cqrs_event_tags o WHERE o.log = $1 AND o.position = t.position AND o.tag = ANY($2)) = cardinality($2)) AND (cardinality($3::text[]) = 0 OR event_type = ANY($3)) ORDER BY position",
