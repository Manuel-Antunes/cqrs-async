  "query": "SELECT position, stream_type, stream_id, sequence, event_type, event_version, payload::text AS \"payload!\", metadata::text AS \"metadata!\", (extract(epoch FROM recorded_at) * 1000000)::bigint AS \"recorded_us!\" FROM cqrs_events WHERE position IN (SELECT t.position FROM cqrs_event_tags t WHERE t.tag = ($1::text[])[1] AND (SELECT count(*) FROM cqrs_event_tags o WHERE o.position = t.position AND o.tag = ANY($1)) = cardinality($1)) AND (cardinality($2::text[]) = 0 OR event_type = ANY($2)) ORDER BY position",
